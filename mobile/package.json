{
  "name": "inventory-mobile",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "expo": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "jest": "^30.4.2",
    "@babel/preset-env": "^7.28.0"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/api/client.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 80,
        "functions": 85,
        "lines": 85
      }
    },
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "babelrc": false,
          "configFile": false,
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    }
  }
}
